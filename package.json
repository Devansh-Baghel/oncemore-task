{
	"name": "oncemore",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/bun": "^1.3.14",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"react": "^19.2.8",
			"react-dom": "^19.2.8",
			"sonner": "^2.0.7",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react": "^19.2.17",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@oncemore/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@oncemore/config": "workspace:*",
		"@types/bun": "catalog:",
		"turbo": "^2.10.7",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.2.19"
}
