{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"agent": "bun run src/cli.ts"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.40",
		"@oncemore/agent": "workspace:*",
		"@oncemore/env": "workspace:*",
		"ai": "^7.0.84",
		"cors": "^2.8.6",
		"dotenv": "catalog:",
		"express": "^5.2.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@oncemore/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"tsdown": "^0.22.14",
		"typescript": "catalog:"
	}
}
