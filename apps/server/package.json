{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "node dist/index.mjs",
		"agent": "bun run src/cli.ts",
		"gcp-build": "echo 'skip gcp-build, using prebuilt dist/index.mjs'"
	},
	"dependencies": {
		"@ai-sdk/amazon-bedrock": "^5.0.68",
		"ai": "^7.0.84",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"tsdown": "^0.22.14",
		"typescript": "^6.0.3"
	}
}
