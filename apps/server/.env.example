# Copy to .env and fill in. Both keys are free-tier.
# NVIDIA NIM: create a free account and API key at https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-...
# Exa: free-tier API key at https://dashboard.exa.ai
EXA_API_KEY=...
# Optional override for the OpenAI-compatible endpoint (default: NVIDIA NIM)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# CORS origin for the Next.js web app
CORS_ORIGIN=http://localhost:3001
